{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eduvia-notifications",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "ALLOWED_ORIGIN": "https://eduvia-pmso.onrender.com",
    "VAPID_SUBJECT": "https://eduvia-pmso.onrender.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eduvia-notifications",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
