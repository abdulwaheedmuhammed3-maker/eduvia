{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eduvia-notifications",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "ALLOWED_ORIGIN": "https://eduvia-study-planner.onrender.com,https://eduvia-pmso.onrender.com,https://localhost,http://localhost:8000,http://127.0.0.1:8000,capacitor://localhost",
    "VAPID_SUBJECT": "https://eduvia-study-planner.onrender.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eduvia-notifications",
      "database_id": "eb999b4b-082c-40dc-87ed-f50ad3842dca",
      "migrations_dir": "migrations"
    }
  ]
}

